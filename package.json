{
  "name": "fusion-bench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "serve": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:bookmarklet": "node scripts/qbo-snapshot/build-bookmarklet.mjs",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "deploy:static": "SKIP_VERSION_BUMP=1 bash scripts/deploy.sh",
    "build:shipit": "BASE_PATH=./ npm run build -- --base=./",
    "shipit": "command -v bench >/dev/null 2>&1 && bench shipit || { echo 'Install the Design Bench CLI first: https://github.intuit.com/jmehlhoff/bench-cli'; exit 1; }",
    "dev:clean": "rm -rf node_modules/.vite && npm run dev"
  },
  "dependencies": {
    "@design-systems/icons": "^5.13.1",
    "@design-systems/theme": "6.1.4",
    "@floating-ui/react": "^0.27.16",
    "@genux-ds/animated-brand": "2.6.0",
    "@genux-ds/suggestion-chip": "3.3.4",
    "@iaqb/animated-border": "^1.11.0",
    "@ids-ts/badge": "^5.107.1",
    "@ids-ts/button": "^5.107.1",
    "@ids-ts/cards": "5.165.0",
    "@ids-ts/carousel": "5.178.2",
    "@ids-ts/checkbox": "5.165.0",
    "@ids-ts/dropdown": "^5.123.2",
    "@ids-ts/dropdown-button": "^5.109.0",
    "@ids-ts/icon-control": "^5.109.0",
    "@ids-ts/link": "5.178.2",
    "@ids-ts/loader": "^5.107.1",
    "@ids-ts/pagination": "5.165.0",
    "@ids-ts/styles": "^5.107.1",
    "@ids-ts/table": "5.165.0",
    "@ids-ts/tabs": "5.165.0",
    "@ids-ts/tooltip": "5.165.0",
    "@ids-ts/typography": "5.149.0",
    "bench-extras": "git+ssh://git@github.intuit.com/jmehlhoff/bench-extras.git#main",
    "bench-shells": "git+ssh://git@github.intuit.com/jmehlhoff/bench-shells.git#master",
    "classnames": "^2.5.1",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "sass-embedded": "^1.93.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
